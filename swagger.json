{
  "swagger": "2.0",
  "info": {
    "title": "Campus Connect API",
    "description": "Campus Connect API for managing users, events, and venues.",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/users/": {
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Get all users.",
        "responses": {
          "200": {
            "description": "List of all users."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "description": "Register a new user.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "409": {
            "description": "A user with the submitted email already exists."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Get a user by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "description": "Update an existing user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "404": {
            "description": "User not found."
          },
          "409": {
            "description": "The updated email is already in use."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "description": "Delete a user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/events/": {
      "get": {
        "tags": [
          "Events"
        ],
        "description": "Get all events. Supports category, status, venueId, organizerId, from, and to filters.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "required": false,
            "enum": [
              "draft",
              "published",
              "cancelled",
              "completed"
            ]
          },
          {
            "name": "venueId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "organizerId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "from",
            "in": "query",
            "type": "string",
            "format": "date-time",
            "required": false
          },
          {
            "name": "to",
            "in": "query",
            "type": "string",
            "format": "date-time",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "List of events."
          },
          "400": {
            "description": "Invalid filter value."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Events"
        ],
        "description": "Create a new event.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "description": "Get an event by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Event found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Events"
        ],
        "description": "Update one or more fields on an event.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Events"
        ],
        "description": "Delete an event.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/venues/": {
      "get": {
        "tags": [
          "Venues"
        ],
        "description": "Get all active venues.",
        "responses": {
          "200": {
            "description": "List of active venues."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Venues"
        ],
        "description": "Create a new venue.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/InPersonVenue"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Venue created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/venues/{id}": {
      "get": {
        "tags": [
          "Venues"
        ],
        "description": "Get a venue by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Venue found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Venues"
        ],
        "description": "Update an existing venue.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VenueUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venue updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Venues"
        ],
        "description": "Deactivate a venue (soft delete).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Venue deactivated successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "fail"
        },
        "message": {
          "type": "string",
          "example": "Validation failed for this request."
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "password": {
          "type": "string",
          "example": "SecurePass123!"
        },
        "role": {
          "type": "string",
          "example": "user"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/profile-image.jpg"
        }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Smith"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/new-profile-image.jpg"
        }
      }
    },
    "Event": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Campus Technology Fair"
        },
        "description": {
          "type": "string",
          "example": "Students present technology projects to the campus community."
        },
        "category": {
          "type": "string",
          "example": "Technology"
        },
        "startDate": {
          "type": "string",
          "example": "2026-08-15T15:00:00.000Z"
        },
        "endDate": {
          "type": "string",
          "example": "2026-08-15T18:00:00.000Z"
        },
        "venueId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7ca"
        },
        "organizerId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7c8"
        },
        "capacity": {
          "type": "number",
          "example": 150
        },
        "status": {
          "type": "string",
          "example": "published"
        },
        "imageUrl": {
          "type": "string",
          "example": "https://example.com/events/technology-fair.jpg"
        }
      }
    },
    "EventUpdate": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "number",
          "example": 200
        },
        "status": {
          "type": "string",
          "example": "published"
        }
      }
    },
    "InPersonVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Library Auditorium"
        },
        "venueType": {
          "type": "string",
          "example": "in-person"
        },
        "building": {
          "type": "string",
          "example": "Library Building"
        },
        "room": {
          "type": "string",
          "example": "205"
        },
        "address": {
          "type": "string",
          "example": "Campus North"
        },
        "capacity": {
          "type": "number",
          "example": 150
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Wheelchair accessible."
        }
      }
    },
    "OnlineVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Zoom Conference Room"
        },
        "venueType": {
          "type": "string",
          "example": "online"
        },
        "meetingLink": {
          "type": "string",
          "example": "https://zoom.us/j/123456789"
        },
        "capacity": {
          "type": "number",
          "example": 500
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Live captions enabled."
        }
      }
    },
    "VenueUpdate": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "number",
          "example": 250
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Recently renovated and wheelchair accessible."
        }
      }
    }
  }
}