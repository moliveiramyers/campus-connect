{
  "swagger": "2.0",
  "info": {
    "title": "Campus Connect API",
    "description": "Campus Connect API for managing users, events, venues, and registrations. Sign in at /auth/login or /auth/github before using protected routes.",
    "version": "2.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "githubOAuth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://github.com/login/oauth/authorize",
      "tokenUrl": "https://github.com/login/oauth/access_token",
      "scopes": {
        "user:email": "Read the authenticated GitHub account email"
      }
    }
  },
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/users/": {
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Get all users. Requires an authenticated session with admin privileges.",
        "responses": {
          "200": {
            "description": "List of all users."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "description": "Register a new user. Requires an authenticated session with admin privileges.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "409": {
            "description": "A user with the submitted email already exists."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "description": "Get a user by its ID. Requires an authenticated session with admin privileges or the user themselves.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "description": "Update an existing user. Requires an authenticated session with admin privileges or the user themselves.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "404": {
            "description": "User not found."
          },
          "409": {
            "description": "The updated email is already in use."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "description": "Delete a user (soft delete). Requires an authenticated session with admin privileges or the user themselves.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/events/": {
      "get": {
        "tags": [
          "Events"
        ],
        "description": "Get all events. Supports category, status, venueId, organizerId, from, and to filters.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "required": false,
            "enum": [
              "draft",
              "published",
              "cancelled",
              "completed"
            ]
          },
          {
            "name": "venueId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "organizerId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "from",
            "in": "query",
            "type": "string",
            "format": "date-time",
            "required": false
          },
          {
            "name": "to",
            "in": "query",
            "type": "string",
            "format": "date-time",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "List of events."
          },
          "400": {
            "description": "Invalid filter value."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Events"
        ],
        "description": "Create a new event. Requires an authenticated session with admin privileges.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "description": "Get an event by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Event found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Events"
        ],
        "description": "Update one or more fields on an event. Requires an authenticated session with admin privileges.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Events"
        ],
        "description": "Delete an event. Requires an authenticated session with admin privileges.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Event ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Event not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/venues/": {
      "get": {
        "tags": [
          "Venues"
        ],
        "description": "Get all active venues.",
        "responses": {
          "200": {
            "description": "List of active venues."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Venues"
        ],
        "description": "Create a new venue.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/InPersonVenue"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Venue created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/venues/{id}": {
      "get": {
        "tags": [
          "Venues"
        ],
        "description": "Get a venue by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Venue found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Venues"
        ],
        "description": "Update an existing venue.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VenueUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venue updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Venues"
        ],
        "description": "Deactivate a venue (soft delete).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Venue ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Venue deactivated successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Venue not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/registrations/": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "description": "Get all registrations. Supports userId, eventId, and status filters. Requires an authenticated session with admin privileges.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "eventId",
            "in": "query",
            "type": "string",
            "required": false
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "required": false,
            "enum": [
              "registered",
              "waitlisted",
              "cancelled",
              "attended"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "List of registrations."
          },
          "400": {
            "description": "Invalid filter value."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "post": {
        "tags": [
          "Registrations"
        ],
        "description": "Create a registration. Requires an authenticated session.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Registration"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registration created successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "401": {
            "description": "Authentication required."
          },
          "409": {
            "description": "This user is already registered for this event."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/registrations/{id}": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "description": "Get a registration by its ID. Requires an authenticated session with admin privileges or the owner of the registration.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Registration ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Registration found successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "404": {
            "description": "Registration not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "put": {
        "tags": [
          "Registrations"
        ],
        "description": "Update a registration. Requires an authenticated session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Registration ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegistrationUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registration updated successfully."
          },
          "400": {
            "description": "Invalid ID or request body."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Registration not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Registrations"
        ],
        "description": "Delete a registration. Requires an authenticated session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Registration ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Registration deleted successfully."
          },
          "400": {
            "description": "Invalid MongoDB ObjectId."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Registration not found."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Start the GitHub OAuth login flow.",
        "produces": [
          "text/html"
        ],
        "responses": {
          "302": {
            "description": "Redirect to GitHub for authentication."
          },
          "503": {
            "description": "OAuth environment variables are not configured."
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "GitHub OAuth callback. GitHub redirects the user here after authorization.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "302": {
            "description": "Authentication succeeded; redirect to Swagger UI."
          },
          "401": {
            "description": "GitHub authentication failed."
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Return the current OAuth session status.",
        "responses": {
          "200": {
            "description": "Current authentication status."
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Register a new user with email, password, name, and optional profile image.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewUser"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User registered successfully."
          },
          "400": {
            "description": "Request validation failed."
          },
          "409": {
            "description": "A user with this email already exists."
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Log in with local credentials and establish a session.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful."
          },
          "400": {
            "description": "Request validation failed."
          },
          "401": {
            "description": "Invalid email or password."
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "End the current OAuth session.",
        "responses": {
          "200": {
            "description": "Logout completed."
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "fail"
        },
        "message": {
          "type": "string",
          "example": "Validation failed for this request."
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "password": {
          "type": "string",
          "example": "SecurePass123!"
        },
        "role": {
          "type": "string",
          "example": "user"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/profile-image.jpg"
        }
      }
    },
    "NewUser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "password": {
          "type": "string",
          "example": "SecurePass123!"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/profile-image.jpg"
        }
      }
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "password": {
          "type": "string",
          "example": "SecurePass123!"
        }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Smith"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/new-profile-image.jpg"
        }
      }
    },
    "Event": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Campus Technology Fair"
        },
        "description": {
          "type": "string",
          "example": "Students present technology projects to the campus community."
        },
        "category": {
          "type": "string",
          "example": "Technology"
        },
        "startDate": {
          "type": "string",
          "example": "2026-08-15T15:00:00.000Z"
        },
        "endDate": {
          "type": "string",
          "example": "2026-08-15T18:00:00.000Z"
        },
        "venueId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7ca"
        },
        "organizerId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7c8"
        },
        "capacity": {
          "type": "number",
          "example": 150
        },
        "status": {
          "type": "string",
          "example": "published"
        },
        "imageUrl": {
          "type": "string",
          "example": "https://example.com/events/technology-fair.jpg"
        }
      }
    },
    "EventUpdate": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "number",
          "example": 200
        },
        "status": {
          "type": "string",
          "example": "published"
        }
      }
    },
    "InPersonVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Library Auditorium"
        },
        "venueType": {
          "type": "string",
          "example": "in-person"
        },
        "building": {
          "type": "string",
          "example": "Library Building"
        },
        "room": {
          "type": "string",
          "example": "205"
        },
        "address": {
          "type": "string",
          "example": "Campus North"
        },
        "capacity": {
          "type": "number",
          "example": 150
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Wheelchair accessible."
        }
      }
    },
    "OnlineVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Zoom Conference Room"
        },
        "venueType": {
          "type": "string",
          "example": "online"
        },
        "meetingLink": {
          "type": "string",
          "example": "https://zoom.us/j/123456789"
        },
        "capacity": {
          "type": "number",
          "example": 500
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Live captions enabled."
        }
      }
    },
    "VenueUpdate": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "number",
          "example": 250
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Recently renovated and wheelchair accessible."
        }
      }
    },
    "Registration": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7c8"
        },
        "eventId": {
          "type": "string",
          "example": "66b4b7d9a2f1c3e4d5a6b7c9"
        },
        "status": {
          "type": "string",
          "example": "registered"
        },
        "notes": {
          "type": "string",
          "example": "Requires wheelchair seating."
        }
      }
    },
    "RegistrationUpdate": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "attended"
        },
        "notes": {
          "type": "string",
          "example": "Checked in at the main entrance."
        }
      }
    }
  }
}