  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Doe"
        },
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "password": {
          "type": "string",
          "example": "SecurePass123!"
        },
        "role": {
          "type": "string",
          "example": "user"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/profile-image.jpg"
        }
      }
    },
    "UserUpdate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Jane Smith"
        },
        "profileImage": {
          "type": "string",
          "example": "https://example.com/new-profile-image.jpg"
        }
      }
    },
    "InPersonVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Library Auditorium"
        },
        "venueType": {
          "type": "string",
          "example": "in-person"
        },
        "building": {
          "type": "string",
          "example": "Library Building"
        },
        "room": {
          "type": "string",
          "example": "205"
        },
        "address": {
          "type": "string",
          "example": "Campus North"
        },
        "capacity": {
          "type": "number",
          "example": 150
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Wheelchair accessible."
        }
      }
    },
    "OnlineVenue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Zoom Conference Room"
        },
        "venueType": {
          "type": "string",
          "example": "online"
        },
        "meetingLink": {
          "type": "string",
          "example": "https://zoom.us/j/123456789"
        },
        "capacity": {
          "type": "number",
          "example": 500
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Live captions enabled."
        }
      }
    },
    "VenueUpdate": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "number",
          "example": 250
        },
        "accessibilityNotes": {
          "type": "string",
          "example": "Recently renovated and wheelchair accessible."
        }
      }
    }
