# Protected requests require a same-site authenticated session. For the final
# demonstration, sign in through /auth/github and execute them in Swagger UI.
# Replace the IDs above with the IDs returned by the temporary demo records.

### Health
GET {{baseUrl}}/

### Swagger document
GET {{baseUrl}}/swagger.json

### Authentication status
GET {{baseUrl}}/auth/status

### Begin GitHub OAuth (open in a browser)
GET {{baseUrl}}/auth/github

### Users — GET all
GET {{baseUrl}}/users

### Users — GET one
GET {{baseUrl}}/users/{{userId}}

### Users — POST
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Week 07 Demo User",
  "email": "week07.demo.user@example.com",
  "password": "Campus123!",
  "role": "user",
  "profileImage": "https://example.com/week07-user.jpg"
}

### Users — PUT
PUT {{baseUrl}}/users/{{userId}}
Content-Type: application/json

{
  "name": "Week 07 Updated User"
}

### Users — DELETE (soft delete)
DELETE {{baseUrl}}/users/{{userId}}

### Venues — GET all
GET {{baseUrl}}/venues

### Venues — GET one
GET {{baseUrl}}/venues/{{venueId}}

### Venues — POST
POST {{baseUrl}}/venues
Content-Type: application/json

{
  "name": "Week 07 Demo Auditorium",
  "venueType": "in-person",
  "building": "Student Center",
  "room": "201",
  "address": "Campus Central",
  "capacity": 80,
  "accessibilityNotes": "Elevator access available."
}

### Venues — PUT
PUT {{baseUrl}}/venues/{{venueId}}
Content-Type: application/json

{
  "capacity": 100,
  "accessibilityNotes": "Elevator and live caption display available."
}

### Venues — DELETE (soft delete)
DELETE {{baseUrl}}/venues/{{venueId}}

### Events — GET all
GET {{baseUrl}}/events

### Events — GET one
GET {{baseUrl}}/events/{{eventId}}

### Events — POST
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Week 07 Campus Technology Fair",
  "description": "Students present final technology projects to the campus community.",
  "category": "Technology",
  "startDate": "2026-08-20T15:00:00.000Z",
  "endDate": "2026-08-20T18:00:00.000Z",
  "venueId": "{{venueId}}",
  "organizerId": "{{userId}}",
  "capacity": 80,
  "status": "published",
  "imageUrl": "https://example.com/week07-fair.jpg"
}

### Events — PUT
PUT {{baseUrl}}/events/{{eventId}}
Content-Type: application/json

{
  "capacity": 100,
  "status": "published"
}

### Events — DELETE
DELETE {{baseUrl}}/events/{{eventId}}

### Registrations — GET all
GET {{baseUrl}}/registrations

### Registrations — GET one
GET {{baseUrl}}/registrations/{{registrationId}}

### Registrations — POST (admin body)
POST {{baseUrl}}/registrations
Content-Type: application/json

{
  "userId": "{{userId}}",
  "eventId": "{{eventId}}",
  "status": "registered",
  "notes": "Week 07 demonstration registration."
}

### Registrations — PUT
PUT {{baseUrl}}/registrations/{{registrationId}}
Content-Type: application/json

{
  "status": "attended",
  "notes": "Checked in during the final demonstration."
}

### Registrations — DELETE
DELETE {{baseUrl}}/registrations/{{registrationId}}

### Validation example — invalid Event POST returns 400
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "No",
  "capacity": 0
}

### Validation example — invalid Venue PUT returns 400
PUT {{baseUrl}}/venues/{{venueId}}
Content-Type: application/json

{
  "capacity": 0
}

### Logout
GET {{baseUrl}}/auth/logout
